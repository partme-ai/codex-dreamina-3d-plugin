.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
build/
dist/
*.egg-info/
.env
.env.*
.ci-venv/
# Locally generated adapter shims. Tests build these under a temp directory;
# a committed copy would embed an absolute private path and a hardcoded
# interpreter, so keep them out of the repository.
tests/fakes/.*.sh
tests/fakes/*.sh

# Generated media must never enter the distribution. Runtime acceptance
# records the reproduction procedure and the artifact digest instead.
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.m4a
